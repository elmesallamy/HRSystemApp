@model IEnumerable<HRSystem.Models.Attendance>
@using System.Globalization

@{
    ViewData["Title"] = "سجل الحضور والانصراف";
    var userEmail = User.Identity.Name;
    var isAdmin = User.IsInRole("Admin");

    // إحصائيات سريعة
    var totalRecords = Model.Count();
    var today = DateTime.Today;
    var todayAttendance = Model.Count(a => a.Date == today);
    var presentCount = Model.Count(a => a.IsPresent == true);
    var lateCount = Model.Count(a => a.Status == "متأخر");
    var leaveCount = Model.Count(a => a.Status == "إجازة");
}

<div class="container-fluid">
    <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
        <h1 class="h2">
            <i class="fas fa-fingerprint text-primary"></i> سجل الحضور والانصراف
        </h1>
        <div class="btn-toolbar mb-2 mb-md-0">
            <div class="btn-group">
                <a href="/Attendance/CheckIn" class="btn btn-success">
                    <i class="fas fa-sign-in-alt me-1"></i> تسجيل حضور
                </a>
                <a href="/Attendance/CheckOut" class="btn btn-warning">
                    <i class="fas fa-sign-out-alt me-1"></i> تسجيل انصراف
                </a>
            </div>
        </div>
    </div>

    <!-- بطاقات الإحصائيات السريعة -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card bg-primary text-white shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title fw-light">إجمالي السجلات</h6>
                            <h2 class="card-text fw-bold mb-0">@totalRecords</h2>
                        </div>
                        <i class="fas fa-database fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card bg-info text-white shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title fw-light">حضور اليوم</h6>
                            <h2 class="card-text fw-bold mb-0">@todayAttendance</h2>
                        </div>
                        <i class="fas fa-calendar-day fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card bg-success text-white shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title fw-light">أيام حضور</h6>
                            <h2 class="card-text fw-bold mb-0">@presentCount</h2>
                        </div>
                        <i class="fas fa-check-circle fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card bg-warning text-white shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title fw-light">إجازات / غياب</h6>
                            <h2 class="card-text fw-bold mb-0">@(lateCount + leaveCount)</h2>
                        </div>
                        <i class="fas fa-clock fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- جدول سجلات الحضور -->
    <div class="card shadow-sm">
        <div class="card-header bg-white py-3">
            <div class="row align-items-center">
                <div class="col">
                    <h5 class="mb-0">
                        <i class="fas fa-list me-2 text-primary"></i> السجلات
                    </h5>
                </div>
                <div class="col-auto">
                    <div class="input-group input-group-sm">
                        <input type="text" id="searchInput" class="form-control" placeholder="بحث..." aria-label="بحث">
                        <button class="btn btn-outline-secondary" type="button" id="searchBtn">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0" id="attendanceTable">
                    <thead class="table-light">
                        <tr>
                            <th>التاريخ</th>
                            @if (isAdmin)
                            {
                                <th>الموظف</th>
                            }
                            <th>وقت الحضور</th>
                            <th>وقت الانصراف</th>
                            <th>عدد الساعات</th>
                            <th>الحالة</th>
                            <th>ملاحظات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var hours = "";
                            if (item.CheckInTime.HasValue && item.CheckOutTime.HasValue)
                            {
                                var diff = item.CheckOutTime.Value - item.CheckInTime.Value;
                                hours = $"{(int)diff.TotalHours}:{diff.Minutes:D2}";
                            }

                            var statusClass = item.Status switch
                            {
                                "حاضر" => "success",
                                "متأخر" => "warning",
                                "إجازة" => "info",
                                _ => "secondary"
                            };

                            <tr>
                                <td class="align-middle">@item.Date.ToString("yyyy-MM-dd")</td>
                                @if (isAdmin)
                                {
                                    <td class="align-middle">@(item.Employee?.Name ?? "-")</td>
                                }
                                <td class="align-middle">@(item.CheckInTime?.ToString("HH:mm") ?? "-")</td>
                                <td class="align-middle">@(item.CheckOutTime?.ToString("HH:mm") ?? "-")</td>
                                <td class="align-middle">@hours</td>
                                <td class="align-middle">
                                    <span class="badge bg-@statusClass">@item.Status</span>
                                </td>
                                <td class="align-middle">@item.Notes</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white">
            <div class="row align-items-center">
                <div class="col">
                    <small class="text-muted">
                        <i class="fas fa-chart-simple me-1"></i> إجمالي السجلات: <strong>@totalRecords</strong>
                    </small>
                </div>
                <div class="col-auto">
                    <small class="text-muted">
                        <i class="fas fa-calendar-week me-1"></i> آخر تحديث: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // وظيفة البحث السريع
        document.getElementById('searchBtn').addEventListener('click', function() {
            var input = document.getElementById('searchInput');
            var filter = input.value.toUpperCase();
            var table = document.getElementById('attendanceTable');
            var tr = table.getElementsByTagName('tr');

            for (var i = 1; i < tr.length; i++) {
                var tdArray = tr[i].getElementsByTagName('td');
                var found = false;
                for (var j = 0; j < tdArray.length; j++) {
                    var txtValue = tdArray[j].textContent || tdArray[j].innerText;
                    if (txtValue.toUpperCase().indexOf(filter) > -1) {
                        found = true;
                        break;
                    }
                }
                tr[i].style.display = found ? '' : 'none';
            }
        });

        // دعم زر Enter في مربع البحث
        document.getElementById('searchInput').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                document.getElementById('searchBtn').click();
            }
        });
    </script>
}
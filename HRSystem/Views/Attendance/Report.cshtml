@model IEnumerable<HRSystem.Models.Attendance>

@{
    ViewData["Title"] = "تقرير الحضور والانصراف";
}

<h2>تقرير الحضور والانصراف</h2>
<hr />

<!-- نموذج الفلترة -->
<div class="card mb-4">
    <div class="card-header">
        <h5>فلترة التقرير</h5>
    </div>
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-4">
                <label class="form-label">الموظف</label>
                <select name="employeeId" class="form-control">
                    <option value="">كل الموظفين</option>
                    @foreach (var emp in ViewBag.Employees)
                    {
                        if (ViewBag.SelectedEmployee == emp.Id)
                        {
                            <option value="@emp.Id" selected>@emp.Name</option>
                        }
                        else
                        {
                            <option value="@emp.Id">@emp.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">من تاريخ</label>
                <input type="date" name="fromDate" class="form-control" value="@ViewBag.FromDate">
            </div>
            <div class="col-md-3">
                <label class="form-label">إلى تاريخ</label>
                <input type="date" name="toDate" class="form-control" value="@ViewBag.ToDate">
            </div>
            <div class="col-md-2">
                <label class="form-label">&nbsp;</label>
                <button type="submit" class="btn btn-primary form-control">عرض التقرير</button>
            </div>
        </form>
    </div>
</div>

<!-- إحصائيات سريعة -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="alert alert-info">
            <strong>إجمالي السجلات:</strong> @ViewBag.TotalRecords
        </div>
    </div>
    <div class="col-md-3">
        <div class="alert alert-success">
            <strong>أيام حضور:</strong> @ViewBag.PresentCount
        </div>
    </div>
    <div class="col-md-3">
        <div class="alert alert-danger">
            <strong>أيام غياب:</strong> @ViewBag.AbsentCount
        </div>
    </div>
    <div class="col-md-3">
        <div class="alert alert-warning">
            <strong>أيام إجازة:</strong> @ViewBag.LeaveCount
        </div>
    </div>
</div>

<!-- زر التصدير -->
<div class="mb-3">
    <a href="@Url.Action("ExportCSV", new { employeeId = ViewBag.SelectedEmployee, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate })"
       class="btn btn-success">📥 تصدير إلى Excel (CSV)</a>
</div>

<!-- جدول التقرير -->
<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>التاريخ</th>
            <th>الموظف</th>
            <th>وقت الحضور</th>
            <th>وقت الانصراف</th>
            <th>الحالة</th>
            <th>ملاحظات</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Date.ToString("yyyy-MM-dd")</td>
                <td>@(item.Employee?.Name ?? "-")</td>
                <td>@(item.CheckInTime?.ToString("HH:mm") ?? "-")</td>
                <td>@(item.CheckOutTime?.ToString("HH:mm") ?? "-")</td>
                <td>
                    @if (item.Status == "حاضر")
                    {
                        <span class="badge bg-success">@item.Status</span>
                    }
                    else if (item.Status == "متأخر")
                    {
                        <span class="badge bg-warning">@item.Status</span>
                    }
                    else if (item.Status == "إجازة")
                    {
                        <span class="badge bg-info">@item.Status</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">@item.Status</span>
                    }
                </td>
                <td>@item.Notes</td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <div class="alert alert-info">لا توجد بيانات للعرض</div>
}
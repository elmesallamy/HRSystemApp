@model HRSystem.Models.Employee

@{
    ViewData["Title"] = "حذف موظف";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
        <h1 class="h2 text-danger">
            <i class="fas fa-trash-alt text-danger"></i> @ViewData["Title"]
        </h1>
        <div class="btn-toolbar mb-2 mb-md-0">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-right me-1"></i> رجوع إلى القائمة
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <!-- بطاقة تحذيرية -->
            <div class="card border-danger shadow-sm mb-4">
                <div class="card-header bg-danger text-white py-3">
                    <h5 class="mb-0">
                        <i class="fas fa-exclamation-triangle me-2"></i> تحذير: أنت على وشك حذف موظف
                    </h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <i class="fas fa-info-circle me-2"></i>
                        <strong>تنبيه:</strong> عملية الحذف نهائية ولا يمكن التراجع عنها. سيتم حذف جميع بيانات الموظف بما في ذلك سجلات الحضور والإجازات.
                    </div>

                    <div class="text-center mb-4">
                        <i class="fas fa-user-slash fa-4x text-muted mb-3"></i>
                        <h3 class="text-danger">هل أنت متأكد من حذف هذا الموظف؟</h3>
                        <p class="text-muted">هذا الإجراء لا يمكن التراجع عنه</p>
                    </div>

                    <!-- بطاقة معلومات الموظف المراد حذفه -->
                    <div class="card bg-light mb-4">
                        <div class="card-body">
                            <h6 class="text-muted mb-3">بيانات الموظف المراد حذفه</h6>
                            <div class="row">
                                <div class="col-md-6 mb-2">
                                    <div class="d-flex align-items-center">
                                        <i class="fas fa-user text-primary me-2"></i>
                                        <span class="fw-semibold">الاسم:</span>
                                        <span class="ms-2">@Model.Name</span>
                                    </div>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <div class="d-flex align-items-center">
                                        <i class="fas fa-envelope text-primary me-2"></i>
                                        <span class="fw-semibold">البريد الإلكتروني:</span>
                                        <span class="ms-2">@Model.Email</span>
                                    </div>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <div class="d-flex align-items-center">
                                        <i class="fas fa-briefcase text-primary me-2"></i>
                                        <span class="fw-semibold">المنصب:</span>
                                        <span class="ms-2">@Model.Position</span>
                                    </div>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <div class="d-flex align-items-center">
                                        <i class="fas fa-building text-primary me-2"></i>
                                        <span class="fw-semibold">القسم:</span>
                                        <span class="ms-2">@Model.Department</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- نموذج التأكيد -->
                    <form asp-action="Delete" id="deleteForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label class="form-label text-danger fw-semibold">
                                <i class="fas fa-check-circle me-1"></i> للتأكيد، اكتب "حذف" في المربع أدناه
                            </label>
                            <input type="text" id="confirmText" class="form-control" placeholder="اكتب 'حذف' لتأكيد الحذف" autocomplete="off" />
                            <small class="text-muted">يجب كتابة الكلمة بالضبط لتتمكن من الحذف</small>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <button type="submit" id="deleteBtn" class="btn btn-danger px-4" disabled>
                                <i class="fas fa-trash-alt me-1"></i> حذف نهائي
                            </button>
                            <a asp-action="Index" class="btn btn-secondary px-4">
                                <i class="fas fa-times me-1"></i> إلغاء
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // تفعيل زر الحذف فقط عند كتابة "حذف" بشكل صحيح
        const confirmInput = document.getElementById('confirmText');
        const deleteBtn = document.getElementById('deleteBtn');

        confirmInput.addEventListener('input', function() {
            if (this.value === 'حذف') {
                deleteBtn.disabled = false;
                deleteBtn.classList.remove('btn-danger');
                deleteBtn.classList.add('btn-dark');
            } else {
                deleteBtn.disabled = true;
                deleteBtn.classList.remove('btn-dark');
                deleteBtn.classList.add('btn-danger');
            }
        });

        // منع الإرسال بالخطأ إذا كان الحقل فارغاً (أمان إضافي)
        document.getElementById('deleteForm').addEventListener('submit', function(e) {
            if (confirmInput.value !== 'حذف') {
                e.preventDefault();
                alert('الرجاء كتابة "حذف" في المربع لتأكيد عملية الحذف');
            }
        });
    </script>
}
﻿@{
ViewData["Title"] = "غير مصرح بالوصول";
Layout = null;
}

<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>غير مصرح - نظام إدارة الموارد البشرية</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            font-family: 'Cairo', sans-serif;
        }

        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .error-card {
            background: rgba(255, 255, 255, 0.98);
            border-radius: 20px;
            padding: 50px 40px;
            width: 100%;
            max-width: 500px;
            text-align: center;
            box-shadow: 0 20px 60px rgba(0,0,0,0.2);
            transition: transform 0.3s ease;
        }

            .error-card:hover {
                transform: translateY(-5px);
            }

        .error-icon {
            font-size: 80px;
            color: #dc3545;
            margin-bottom: 20px;
        }

        .error-card h1 {
            font-size: 2.5rem;
            font-weight: 700;
            color: #333;
            margin-bottom: 15px;
        }

        .error-card p {
            color: #666;
            font-size: 1.1rem;
            margin-bottom: 30px;
        }

        .btn-home {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            padding: 12px 30px;
            font-size: 16px;
            font-weight: bold;
            border-radius: 10px;
            transition: all 0.3s ease;
        }

            .btn-home:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 20px rgba(102, 126, 234, 0.4);
            }

        .btn-logout {
            background: transparent;
            border: 1px solid #dc3545;
            color: #dc3545;
            padding: 12px 30px;
            font-size: 16px;
            font-weight: bold;
            border-radius: 10px;
            transition: all 0.3s ease;
        }

            .btn-logout:hover {
                background: #dc3545;
                color: white;
                transform: translateY(-2px);
            }

        .suggestions {
            margin-top: 30px;
            padding-top: 20px;
            border-top: 1px solid #e0e0e0;
        }

            .suggestions h6 {
                color: #333;
                margin-bottom: 10px;
            }

            .suggestions ul {
                list-style: none;
                padding: 0;
            }

                .suggestions ul li {
                    margin-bottom: 8px;
                }

                    .suggestions ul li a {
                        text-decoration: none;
                        color: #667eea;
                    }

                        .suggestions ul li a:hover {
                            text-decoration: underline;
                        }
    </style>
</head>
<body>
    <div class="error-card">
        <div class="error-icon">
            <i class="fas fa-ban"></i>
        </div>
        <h1>⛔ غير مصرح بالوصول</h1>
        <p>عذراً، ليس لديك صلاحية للوصول إلى هذه الصفحة.</p>
        <p class="small text-muted">إذا كنت تعتقد أن هذا خطأ، يرجى التواصل مع المدير.</p>

        <div class="d-flex justify-content-center gap-3">
            <a href="/" class="btn btn-primary btn-home">
                <i class="fas fa-home me-2"></i> العودة للرئيسية
            </a>
            <a href="/Account/Logout" class="btn btn-logout">
                <i class="fas fa-sign-out-alt me-2"></i> تسجيل خروج
            </a>
        </div>

        <div class="suggestions">
            <h6><i class="fas fa-lightbulb text-warning me-1"></i> صفحات يمكنك الوصول إليها:</h6>
            <ul class="row">
                <li class="col-6">
                    <a href="/Home/Dashboard">
                        <i class="fas fa-tachometer-alt me-1"></i> لوحة التحكم
                    </a>
                </li>
                <li class="col-6">
                    <a href="/Attendance/Index">
                        <i class="fas fa-fingerprint me-1"></i> الحضور والانصراف
                    </a>
                </li>
                <li class="col-6">
                    <a href="/Leaves/MyLeaves">
                        <i class="fas fa-calendar-alt me-1"></i> إجازاتي
                    </a>
                </li>
                <li class="col-6">
                    <a href="/Home/Index">
                        <i class="fas fa-info-circle me-1"></i> الرئيسية
                    </a>
                </li>
            </ul>
        </div>
    </div>
</body>
</html>
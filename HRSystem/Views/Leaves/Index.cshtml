@model IEnumerable<HRSystem.Models.Leave>

@{
    ViewData["Title"] = "طلبات الإجازات";
}

<h2>طلبات الإجازات</h2>

<hr />

<a href="/Leaves/MyLeaves" class="btn btn-info mb-3">إجازاتي</a>
<a href="/Leaves/Create" class="btn btn-success mb-3">طلب إجازة جديد</a>

<table class="table table-striped">
    <thead>
        <tr>
            <th>الموظف</th>
            <th>تاريخ البدء</th>
            <th>تاريخ الانتهاء</th>
            <th>عدد الأيام</th>
            <th>نوع الإجازة</th>
            <th>السبب</th>
            <th>الحالة</th>
            <th>تاريخ الطلب</th>
            <th>إجراءات</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@(item.Employee?.Name ?? "-")</td>
                <td>@item.StartDate.ToString("yyyy-MM-dd")</td>
                <td>@item.EndDate.ToString("yyyy-MM-dd")</td>
                <td>@item.TotalDays</td>
                <td>@item.LeaveType</td>
                <td>@item.Reason</td>
                <td>
                    @if (item.Status == "قيد الانتظار")
                    {
                        <span class="badge bg-warning">@item.Status</span>
                    }
                    else if (item.Status == "موافقة")
                    {
                        <span class="badge bg-success">@item.Status</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">@item.Status</span>
                    }
                </td>
                <td>@item.RequestDate.ToString("yyyy-MM-dd")</td>
                <td>
                    @if (item.Status == "قيد الانتظار")
                    {
                        <form asp-action="Approve" asp-route-id="@item.Id" method="post" style="display:inline">
                            <button type="submit" class="btn btn-sm btn-success">موافقة</button>
                        </form>
                        <a href="#" onclick="showRejectModal(@item.Id)" class="btn btn-sm btn-danger">رفض</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Modal للرفض -->
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">رفض الإجازة</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="rejectId" />
                <label>سبب الرفض:</label>
                <textarea id="rejectionReason" class="form-control" rows="3"></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                <button type="button" class="btn btn-danger" onclick="submitReject()">تأكيد الرفض</button>
            </div>
        </div>
    </div>
</div>

<script>
    function showRejectModal(id) {
        document.getElementById('rejectId').value = id;
        var myModal = new bootstrap.Modal(document.getElementById('rejectModal'));
        myModal.show();
    }

    function submitReject() {
        var id = document.getElementById('rejectId').value;
        var reason = document.getElementById('rejectionReason').value;
         window.location.href = '/Leaves/RejectGet?id=' + id + '&rejectionReason=' + encodeURIComponent(reason);
    }
</script>
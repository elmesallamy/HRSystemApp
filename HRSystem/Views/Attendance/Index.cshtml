@model IEnumerable<HRSystem.Models.Attendance>

@{
    ViewData["Title"] = "سجل الحضور والانصراف";
    var userEmail = User.Identity.Name;
}

<h2>سجل الحضور والانصراف</h2>

<hr />

<div class="row mb-4">
    <div class="col">
        <a href="/Attendance/CheckIn" class="btn btn-success">تسجيل حضور</a>
        <a href="/Attendance/CheckOut" class="btn btn-warning">تسجيل انصراف</a>
    </div>
</div>

<table class="table table-striped table-hover">
    <thead>
        <table>
            <th>التاريخ</th>
            <th>الموظف</th>
            <th>وقت الحضور</th>
            <th>وقت الانصراف</th>
            <th>الحالة</th>
            <th>ملاحظات</th>
            </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Date.ToString("yyyy-MM-dd")</td>
                <td>@(item.Employee?.Name ?? "-")</td>
                <td>@(item.CheckInTime?.ToString("HH:mm") ?? "-")</td>
                <td>@(item.CheckOutTime?.ToString("HH:mm") ?? "-")</td>
                <td>@item.Status</td>
                <td>@item.Notes</td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <div class="alert alert-info">لا توجد سجلات حضور حتى الآن</div>
}
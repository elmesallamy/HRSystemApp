@using HRSystem.Models
@model List<UserRoleViewModel>

@{
    ViewData["Title"] = "إدارة المستخدمين";

    // إحصائيات سريعة
    var totalUsers = Model.Count();
    var approvedUsers = Model.Count(u => u.User.IsApproved);
    var pendingUsers = Model.Count(u => !u.User.IsApproved);
    var adminUsers = Model.Count(u => u.IsAdmin);
    var employeeUsers = Model.Count(u => !u.IsAdmin);
}

<div class="container-fluid">
    <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
        <h1 class="h2">
            <i class="fas fa-users-cog text-primary"></i> @ViewData["Title"]
        </h1>
        <div class="btn-toolbar mb-2 mb-md-0">
            <div class="btn-group">
                <a href="/Home/Dashboard" class="btn btn-secondary">
                    <i class="fas fa-arrow-right me-1"></i> رجوع
                </a>
            </div>
        </div>
    </div>

    <!-- بطاقات الإحصائيات -->
    <div class="row mb-4">
        <div class="col-xl-2 col-md-4 mb-3">
            <div class="card bg-primary text-white shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title fw-light">إجمالي المستخدمين</h6>
                            <h2 class="card-text fw-bold mb-0">@totalUsers</h2>
                        </div>
                        <i class="fas fa-users fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 mb-3">
            <div class="card bg-success text-white shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title fw-light">مفعلون</h6>
                            <h2 class="card-text fw-bold mb-0">@approvedUsers</h2>
                        </div>
                        <i class="fas fa-check-circle fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 mb-3">
            <div class="card bg-warning text-white shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title fw-light">قيد المراجعة</h6>
                            <h2 class="card-text fw-bold mb-0">@pendingUsers</h2>
                        </div>
                        <i class="fas fa-clock fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 mb-3">
            <div class="card bg-danger text-white shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title fw-light">مديرين</h6>
                            <h2 class="card-text fw-bold mb-0">@adminUsers</h2>
                        </div>
                        <i class="fas fa-user-shield fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 mb-3">
            <div class="card bg-info text-white shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title fw-light">موظفين</h6>
                            <h2 class="card-text fw-bold mb-0">@employeeUsers</h2>
                        </div>
                        <i class="fas fa-user-friends fa-2x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- جدول المستخدمين -->
    <div class="card shadow-sm">
        <div class="card-header bg-white py-3">
            <div class="row align-items-center">
                <div class="col">
                    <h5 class="mb-0">
                        <i class="fas fa-list me-2 text-primary"></i> قائمة المستخدمين
                    </h5>
                </div>
                <div class="col-auto">
                    <div class="input-group input-group-sm">
                        <input type="text" id="searchInput" class="form-control" placeholder="بحث..." aria-label="بحث">
                        <button class="btn btn-outline-secondary" type="button" id="searchBtn">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0" id="usersTable">
                    <thead class="table-light">
                        <tr>
                            <th>الاسم</th>
                            <th>البريد الإلكتروني</th>
                            <th>تاريخ التسجيل</th>
                            <th>الحالة</th>
                            <th>الدور الحالي</th>
                            <th>تاريخ التفعيل</th>
                            <th>المفعول بواسطة</th>
                            <th>الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="align-middle">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-light rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px;">
                                            <i class="fas fa-user text-primary"></i>
                                        </div>
                                        <span class="fw-semibold">@item.User.FullName</span>
                                    </div>
                                </td>
                                <td class="align-middle">@item.User.Email</td>
                                <td class="align-middle">@item.User.RegisteredAt.ToString("yyyy-MM-dd")</td>
                                <td class="align-middle">
                                    @if (item.User.IsApproved)
                                    {
                                        <span class="badge bg-success">
                                            <i class="fas fa-check-circle me-1"></i> مفعل
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning">
                                            <i class="fas fa-clock me-1"></i> قيد المراجعة
                                        </span>
                                    }
                                </td>
                                <td class="align-middle">
                                    @if (item.IsAdmin)
                                    {
                                        <span class="badge bg-danger">
                                            <i class="fas fa-user-shield me-1"></i> Admin
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info">
                                            <i class="fas fa-user me-1"></i> Employee
                                        </span>
                                    }
                                </td>
                                <td class="align-middle">@(item.User.ApprovedAt?.ToString("yyyy-MM-dd") ?? "-")</td>
                                <td class="align-middle">@(item.User.ApprovedBy ?? "-")</td>
                                <td class="align-middle">
                                    <div class="btn-group btn-group-sm" role="group">
                                        @if (!item.User.IsApproved)
                                        {
                                            <form method="post" asp-action="ApproveUser" style="display:inline" class="approve-form">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="userId" value="@item.User.Id" />
                                                <button type="submit" class="btn btn-sm btn-success" title="تفعيل">
                                                    <i class="fas fa-check"></i>
                                                </button>
                                            </form>
                                        }

                                        @if (item.User.Email != "admin@hrsystem.com")
                                        {
                                            <div class="dropdown d-inline">
                                                <button class="btn btn-sm btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" title="تغيير الدور">
                                                    <i class="fas fa-exchange-alt"></i>
                                                </button>
                                                <ul class="dropdown-menu">
                                                    <li>
                                                        <form method="post" asp-action="ChangeRole" style="display:inline">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="userId" value="@item.User.Id" />
                                                            <input type="hidden" name="role" value="Employee" />
                                                            <button type="submit" class="dropdown-item @(!item.IsAdmin ? "active" : "")">
                                                                <i class="fas fa-user me-1"></i> Employee
                                                            </button>
                                                        </form>
                                                    </li>
                                                    <li>
                                                        <form method="post" asp-action="ChangeRole" style="display:inline">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="userId" value="@item.User.Id" />
                                                            <input type="hidden" name="role" value="Admin" />
                                                            <button type="submit" class="dropdown-item @(item.IsAdmin ? "active" : "")">
                                                                <i class="fas fa-user-shield me-1"></i> Admin
                                                            </button>
                                                        </form>
                                                    </li>
                                                </ul>
                                            </div>

                                            <form method="post" asp-action="DeleteUser" style="display:inline" class="delete-form" onsubmit="return confirmDelete(event, '@item.User.FullName')">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="userId" value="@item.User.Id" />
                                                <button type="submit" class="btn btn-sm btn-danger" title="حذف">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">
                                                <i class="fas fa-crown text-warning"></i> رئيسي
                                            </span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white">
            <div class="row align-items-center">
                <div class="col">
                    <small class="text-muted">
                        <i class="fas fa-chart-simple me-1"></i> إجمالي المستخدمين: <strong>@totalUsers</strong>
                    </small>
                </div>
                <div class="col-auto">
                    <small class="text-muted">
                        <i class="fas fa-calendar-week me-1"></i> آخر تحديث: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // وظيفة البحث السريع
        document.getElementById('searchBtn').addEventListener('click', function() {
            var input = document.getElementById('searchInput');
            var filter = input.value.toUpperCase();
            var table = document.getElementById('usersTable');
            var tr = table.getElementsByTagName('tr');

            for (var i = 1; i < tr.length; i++) {
                var tdArray = tr[i].getElementsByTagName('td');
                var found = false;
                for (var j = 0; j < tdArray.length - 1; j++) { // -1 لتجاهل عمود الإجراءات
                    var txtValue = tdArray[j].textContent || tdArray[j].innerText;
                    if (txtValue.toUpperCase().indexOf(filter) > -1) {
                        found = true;
                        break;
                    }
                }
                tr[i].style.display = found ? '' : 'none';
            }
        });

        // دعم زر Enter في مربع البحث
        document.getElementById('searchInput').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                document.getElementById('searchBtn').click();
            }
        });

        // تأكيد الحذف المحسن
        function confirmDelete(event, userName) {
            event.preventDefault();
            if (confirm(`⚠️ تحذير: هل أنت متأكد من حذف المستخدم "${userName}"؟\n\nهذا الإجراء لا يمكن التراجع عنه.`)) {
                event.target.closest('form').submit();
            }
            return false;
        }
    </script>
}
@model IEnumerable<HRSystem.Models.Attendance>

@{
    ViewData["Title"] = "تقارير الحضور والانصراف";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
        <h1 class="h2">
            <i class="fas fa-chart-line text-primary"></i> @ViewData["Title"]
        </h1>
        <div class="btn-toolbar mb-2 mb-md-0">
            <div class="btn-group">
                <a href="/Attendance" class="btn btn-secondary">
                    <i class="fas fa-arrow-right me-1"></i> رجوع
                </a>
            </div>
        </div>
    </div>

    <!-- بطاقات الفلترة والإحصائيات في صف واحد -->
    <div class="row mb-4">
        <div class="col-lg-8 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0">
                        <i class="fas fa-filter text-primary me-2"></i> فلترة التقرير
                    </h5>
                </div>
                <div class="card-body">
                    <form method="get" class="row g-3">
                        <div class="col-md-5">
                            <label class="form-label fw-semibold">
                                <i class="fas fa-user text-primary me-1"></i> الموظف
                            </label>
                            <select name="employeeId" class="form-select">
                                <option value="">جميع الموظفين</option>
                                @foreach (var emp in ViewBag.Employees)
                                {
                                    if (ViewBag.SelectedEmployee == emp.Id)
                                    {
                                        <option value="@emp.Id" selected>@emp.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@emp.Id">@emp.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">
                                <i class="fas fa-calendar-alt text-primary me-1"></i> من تاريخ
                            </label>
                            <input type="date" name="fromDate" class="form-control" value="@ViewBag.FromDate">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">
                                <i class="fas fa-calendar-alt text-primary me-1"></i> إلى تاريخ
                            </label>
                            <input type="date" name="toDate" class="form-control" value="@ViewBag.ToDate">
                        </div>
                        <div class="col-md-1 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="fas fa-search me-1"></i>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-lg-4 mb-3">
            <div class="card bg-primary text-white shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title fw-light opacity-75">إجمالي السجلات</h6>
                            <h2 class="card-text fw-bold mb-0">@ViewBag.TotalRecords</h2>
                        </div>
                        <i class="fas fa-database fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- بطاقات الإحصائيات التفصيلية -->
    <div class="row mb-4">
        <div class="col-md-4 mb-3">
            <div class="card bg-success text-white shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title fw-light opacity-75">
                                <i class="fas fa-check-circle me-1"></i> أيام الحضور
                            </h6>
                            <h2 class="card-text fw-bold mb-0">@ViewBag.PresentCount</h2>
                        </div>
                        <i class="fas fa-calendar-check fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card bg-danger text-white shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title fw-light opacity-75">
                                <i class="fas fa-times-circle me-1"></i> أيام الغياب
                            </h6>
                            <h2 class="card-text fw-bold mb-0">@ViewBag.AbsentCount</h2>
                        </div>
                        <i class="fas fa-calendar-times fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card bg-info text-white shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title fw-light opacity-75">
                                <i class="fas fa-umbrella-beach me-1"></i> أيام الإجازة
                            </h6>
                            <h2 class="card-text fw-bold mb-0">@ViewBag.LeaveCount</h2>
                        </div>
                        <i class="fas fa-calendar-alt fa-3x opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- أزرار التصدير -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="btn-group">
                <a href="@Url.Action("ExportCSV", new { employeeId = ViewBag.SelectedEmployee, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate })"
                   class="btn btn-success">
                    <i class="fas fa-file-excel me-2"></i> تصدير إلى Excel (CSV)
                </a>
                <button type="button" class="btn btn-secondary" onclick="window.print()">
                    <i class="fas fa-print me-2"></i> طباعة
                </button>
            </div>
        </div>
    </div>

    <!-- جدول التقرير -->
    <div class="card shadow-sm">
        <div class="card-header bg-white py-3">
            <div class="row align-items-center">
                <div class="col">
                    <h5 class="mb-0">
                        <i class="fas fa-list me-2 text-primary"></i> تفاصيل سجلات الحضور
                    </h5>
                </div>
                <div class="col-auto">
                    <div class="input-group input-group-sm">
                        <input type="text" id="searchInput" class="form-control" placeholder="بحث في الجدول..." aria-label="بحث">
                        <button class="btn btn-outline-secondary" type="button" id="searchBtn">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0" id="reportTable">
                    <thead class="table-light">
                        <tr>
                            <th>التاريخ</th>
                            <th>الموظف</th>
                            <th>وقت الحضور</th>
                            <th>وقت الانصراف</th>
                            <th>عدد الساعات</th>
                            <th>الحالة</th>
                            <th>ملاحظات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var hours = "";
                            if (item.CheckInTime.HasValue && item.CheckOutTime.HasValue)
                            {
                                var diff = item.CheckOutTime.Value - item.CheckInTime.Value;
                                hours = $"{(int)diff.TotalHours}:{diff.Minutes:D2}";
                            }

                            var statusClass = item.Status switch
                            {
                                "حاضر" => "success",
                                "متأخر" => "warning",
                                "إجازة" => "info",
                                "غياب" => "danger",
                                _ => "secondary"
                            };

                            <tr>
                                <td class="align-middle">@item.Date.ToString("yyyy-MM-dd")</td>
                                <td class="align-middle">@(item.Employee?.Name ?? "-")</td>
                                <td class="align-middle">@(item.CheckInTime?.ToString("HH:mm") ?? "-")</td>
                                <td class="align-middle">@(item.CheckOutTime?.ToString("HH:mm") ?? "-")</td>
                                <td class="align-middle">@hours</td>
                                <td class="align-middle">
                                    <span class="badge bg-@statusClass">@item.Status</span>
                                </td>
                                <td class="align-middle">@item.Notes</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-white">
            <div class="row align-items-center">
                <div class="col">
                    <small class="text-muted">
                        <i class="fas fa-chart-simple me-1"></i> إجمالي السجلات المعروضة: <strong>@Model.Count()</strong>
                    </small>
                </div>
                <div class="col-auto">
                    <small class="text-muted">
                        <i class="fas fa-calendar-week me-1"></i> تاريخ التقرير: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info mt-3">
        <i class="fas fa-info-circle me-2"></i> لا توجد بيانات للعرض. حاول تغيير معايير الفلترة.
    </div>
}

@section Scripts {
    <script>
        // وظيفة البحث السريع في الجدول
        document.getElementById('searchBtn').addEventListener('click', function() {
            var input = document.getElementById('searchInput');
            var filter = input.value.toUpperCase();
            var table = document.getElementById('reportTable');
            var tr = table.getElementsByTagName('tr');

            for (var i = 1; i < tr.length; i++) {
                var tdArray = tr[i].getElementsByTagName('td');
                var found = false;
                for (var j = 0; j < tdArray.length; j++) {
                    var txtValue = tdArray[j].textContent || tdArray[j].innerText;
                    if (txtValue.toUpperCase().indexOf(filter) > -1) {
                        found = true;
                        break;
                    }
                }
                tr[i].style.display = found ? '' : 'none';
            }
        });

        // دعم زر Enter في مربع البحث
        document.getElementById('searchInput').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                document.getElementById('searchBtn').click();
            }
        });

        // دعم الطباعة - إخفاء بعض العناصر عند الطباعة
        if (typeof window.matchMedia === 'function') {
            var mediaQueryList = window.matchMedia('print');
            mediaQueryList.addListener(function(mql) {
                if (mql.matches) {
                    // قبل الطباعة، يمكن إخفاء عناصر مثل الأزرار إذا أردت
                    console.log('طباعة...');
                }
            });
        }
    </script>
}
@model HRSystem.Models.Leave

@{
    ViewData["Title"] = "طلب إجازة";
}

<h2>طلب إجازة جديد</h2>
<hr />

<h4>الموظف: @ViewBag.EmployeeName</h4>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="LeaveType" class="control-label">نوع الإجازة</label>
                <select asp-for="LeaveType" class="form-control">
                    <option value="سنوية">سنوية</option>
                    <option value="مرضية">مرضية</option>
                    <option value="طارئة">طارئة</option>
                    <option value="بدون راتب">بدون راتب</option>
                </select>
            </div>

            <div class="form-group mb-3">
                <label asp-for="StartDate" class="control-label">تاريخ البدء</label>
                <input asp-for="StartDate" class="form-control" type="date" />
                <span asp-validation-for="StartDate" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="EndDate" class="control-label">تاريخ الانتهاء</label>
                <input asp-for="EndDate" class="form-control" type="date" />
                <span asp-validation-for="EndDate" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Reason" class="control-label">سبب الإجازة</label>
                <textarea asp-for="Reason" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Reason" class="text-danger"></span>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary">إرسال الطلب</button>
                <a asp-action="MyLeaves" class="btn btn-secondary">إلغاء</a>
            </div>
        </form>
    </div>
</div>
@using HRSystem.Models
@model List<HRSystem.Models.UserRoleViewModel>

@{
    ViewData["Title"] = "إدارة المستخدمين";
}

<h2>إدارة المستخدمين</h2>
<hr />

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>الاسم</th>
            <th>البريد الإلكتروني</th>
            <th>تاريخ التسجيل</th>
            <th>الحالة</th>
            <th>الدور الحالي</th>
            <th>تاريخ التفعيل</th>
            <th>الإجراءات</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.User.FullName</td>
                <td>@item.User.Email</td>
                <td>@item.User.RegisteredAt.ToString("yyyy-MM-dd")</td>
                <td>
                    @if (item.User.IsApproved)
                    {
                        <span class="badge bg-success">✅ مفعل</span>
                    }
                    else
                    {
                        <span class="badge bg-warning">⏳ قيد المراجعة</span>
                    }
                </td>
                <td>
                    @if (item.IsAdmin)
                    {
                        <span class="badge bg-danger">Admin</span>
                    }
                    else
                    {
                        <span class="badge bg-info">Employee</span>
                    }
                </td>
                <td>@(item.User.ApprovedAt?.ToString("yyyy-MM-dd") ?? "-")</td>
                <td>
                    @if (!item.User.IsApproved)
                    {
                        <form method="post" asp-action="ApproveUser" style="display:inline">
                            <input type="hidden" name="userId" value="@item.User.Id" />
                            <button type="submit" class="btn btn-sm btn-success">✅ تفعيل</button>
                        </form>
                    }

                    @if (item.User.Email != "admin@hrsystem.com")
                    {
                        <form method="post" asp-action="ChangeRole" style="display:inline">
                            <input type="hidden" name="userId" value="@item.User.Id" />
                            <select name="role" class="form-select form-select-sm d-inline w-auto">
                                <option value="Employee" selected="@(!item.IsAdmin)">Employee</option>
                                <option value="Admin" selected="@(item.IsAdmin)">Admin</option>
                            </select>
                            <button type="submit" class="btn btn-sm btn-primary">تغيير</button>
                        </form>

                        <form method="post" asp-action="DeleteUser" style="display:inline" onsubmit="return confirm('هل أنت متأكد من حذف هذا المستخدم؟')">
                            <input type="hidden" name="userId" value="@item.User.Id" />
                            <button type="submit" class="btn btn-sm btn-danger">🗑 حذف</button>
                        </form>
                    }
                    else
                    {
                        <span class="text-muted">(الأدمن الرئيسي)</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>